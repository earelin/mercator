<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Test methods use snake_case; suppress camelCase-only MethodName check in test sources. -->
  <suppress checks="MethodName" files=".*Test.*\.java|.*IT\.java|.*Steps\.java|.*TestFixtures.*\.java"/>
</suppressions>
