{
  // markdownlint-cli2 config — https://github.com/DavidAnson/markdownlint-cli2
  "config": {
    "default": true,
    "MD013": false,                       // line length: prose is hard-wrapped, but tables/URLs exceed
    "MD024": { "siblings_only": true },   // allow repeated section names under different parents
    "MD033": false,                       // allow occasional inline HTML
    "MD060": false                        // table-column-style: too opinionated for our hand-written tables
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/build/**",
    "**/.gradle/**",
    "**/.mermaid/tmp/**",
    ".git/**",
    ".claude/**"
  ]
}
